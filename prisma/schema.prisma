generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  nickname      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  walletAddress String?
  isVerified    Boolean   @default(false)
  trustScore    Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  tickets      Ticket[]        @relation("SellerTickets")
  purchases    Transaction[]   @relation("BuyerTransactions")
  sales        Transaction[]   @relation("SellerTransactions")
  memberships  Membership[]
  posts        Post[]
  comments     Comment[]
  reviewsGiven Review[]        @relation("ReviewsGiven")
  reviewsReceived Review[]     @relation("ReviewsReceived")
  favorites    Favorite[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("MUSICAL")
  venue     String
  startDate DateTime
  endDate   DateTime
  imageUrl  String?
  cast      String[]
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model Ticket {
  id               String   @id @default(cuid())
  sellerId         String
  eventId          String
  title            String
  originalPrice    Int
  askingPrice      Int
  quantity         Int      @default(1)
  section          String
  row              String
  seatNumber       String?
  floor            String
  seatGrade        String   @default("A")
  position         String?
  showDate         DateTime
  cast             String?
  description      String?  @db.Text
  imageUrls        String[]
  status           String   @default("ACTIVE")
  transferType     String   @default("PIN")
  isConsecutive    Boolean  @default(false)
  isUnderFaceValue Boolean  @default(false)
  isVerified       Boolean  @default(false)
  viewCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  seller       User          @relation("SellerTickets", fields: [sellerId], references: [id])
  event        Event         @relation(fields: [eventId], references: [id])
  transactions Transaction[]
  favorites    Favorite[]

  @@index([eventId])
  @@index([status])
  @@index([showDate])
}

model Transaction {
  id            String   @id @default(cuid())
  ticketId      String
  buyerId       String
  sellerId      String
  amount        Int
  paymentMethod String
  txHash        String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id])
  buyer  User   @relation("BuyerTransactions", fields: [buyerId], references: [id])
  seller User   @relation("SellerTransactions", fields: [sellerId], references: [id])
}

model Membership {
  id            String   @id @default(cuid())
  userId        String
  plan          String   @default("BASIC")
  startDate     DateTime @default(now())
  endDate       DateTime
  isActive      Boolean  @default(true)
  paymentMethod String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String   @db.Text
  category  String   @default("FREE")
  imageUrls String[]
  viewCount Int      @default(0)
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id])
  comments Comment[]
  likes    Like[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String   @db.Text
  parentId  String?
  createdAt DateTime @default(now())

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id])
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")
}

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  revieweeId String
  rating     Int
  content    String?  @db.Text
  createdAt  DateTime @default(now())

  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  ticketId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([userId, ticketId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}
